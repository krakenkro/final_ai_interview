# Core OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
HR_ANALYSIS_PROVIDER=openai
HR_ANALYSIS_MODEL=gpt-4o-mini
HR_ANALYSIS_MAX_INPUT_CHARS=16000
HR_ANALYSIS_MAX_OUTPUT_TOKENS=2200
QUESTION_PHRASING_ENABLED=true
QUESTION_PHRASING_PROVIDER=openai
QUESTION_PHRASING_MODEL=gpt-4o-mini
QUESTION_PHRASING_TEMPERATURE=0.15
QUESTION_PHRASING_MAX_TOKENS=120

# RAG / vector store
CHROMA_COLLECTION_NAME=knowledge_chunks
OPENAI_EMBEDDING_BATCH_SIZE=64

# Optional later-stage variables
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-prep-copilot

# LANGSMITH_ENDPOINT=
FAL_KEY=
FAL_TTS_MODEL=fal-ai/minimax/speech-02-hd
FAL_TTS_LANGUAGE=Russian
FAL_VOICE_CLONE_PREVIEW_MODEL=speech-02-hd
